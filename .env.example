# .env.example: copy to .env and adjust. Never commit the real .env.
# Durations need a unit: 500ms, 5s, 2m, 1h ("30" alone is invalid).

# ---------- App ----------
# REQUIRED. One of: development | staging | production
APP_ENV=development
APP_NAME=auth-system-go

# ---------- HTTP ----------
# REQUIRED. host:port, port 1-65535 (":8080" listens on all interfaces)
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s       # must not exceed HTTP_READ_TIMEOUT
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_DRAIN_DELAY=0s               # must not be negative
HTTP_MAX_BODY_BYTES=1048576       # 1 MiB
HTTP_MAX_HEADER_BYTES=65536       # 64 KiB

# ---------- Logger ----------
LOG_LEVEL=debug                    # debug | info | warn | error
LOG_FORMAT=json                   # json | text (production requires json)
LOG_ADD_SOURCE=false              # true | false

# ---------- Database ----------
# REQUIRED. postgres:// or postgresql:// URL with a database name.
# Production requires sslmode=require, verify-ca, or verify-full.
DATABASE_URL=postgres://app:app@localhost:5432/auth_system_go?sslmode=disable
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=auth_system_go
DB_MAX_CONNS=10                   # 1-1000
DB_MIN_CONNS=2                    # 0 up to DB_MAX_CONNS
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s             # must not exceed DB_STARTUP_TIMEOUT
DB_STARTUP_TIMEOUT=15s
DB_HEALTH_TIMEOUT=3s
